# copy to .env and fill in
DOMAIN=api.example.com
ADMIN_TOKEN=change-me-long-random
# optional Stripe usage-based billing: create a Billing Meter named inference_usd_cents
# (aggregation: sum), attach it to a price on a subscription, then set:
STRIPE_API_KEY=
STRIPE_METER_EVENT=inference_usd_cents
MAX_CONCURRENCY_PER_KEY=16
UPSTREAM_TIMEOUT_S=600
HF_TOKEN=
